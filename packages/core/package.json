{
    "name": "kysely-schema",
    "version": "0.1.5",
    "description": "Schema-first development tool for Kysely",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [
        "kysely",
        "schema",
        "migration",
        "database",
        "typescript",
        "sql"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/guntur-d/kysely-schema.git",
        "directory": "packages/core"
    },
    "homepage": "https://github.com/guntur-d/kysely-schema#readme",
    "bugs": {
        "url": "https://github.com/guntur-d/kysely-schema/issues"
    },
    "license": "MIT",
    "peerDependencies": {
        "kysely": "^0.27.0"
    },
    "devDependencies": {
        "kysely": "^0.27.0",
        "tsup": "^8.0.1",
        "typescript": "^5.3.3",
        "vitest": "^1.1.0"
    }
}